{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(echo *)",
      "Bash(eslint *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git log *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jest *)",
      "Bash(jq *)",
      "Bash(ls*)",
      "Bash(less *)",
      "Bash(make *)",
      "Bash(mkdir *)",
      "Bash(npm *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx tsc --version *)",
      "Bash(pip *)",
      "Bash(pnpm *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(rgrep *)",
      "Bash(run_silent *)",
      "Bash(sed *)",
      "Bash(shellcheck *)",
      "Bash(sort *)",
      "Bash(source .venv/bin/activate)",
      "Bash(source venv/bin/activate)",
      "Bash(sqlite *)",
      "Bash(sqlite3 *)",
      "Bash(sleep *)",
      "Bash(tail *)",
      "Bash(timeout *)",
      "Bash(touch *)",
      "Bash(tr *)",
      "Bash(tree *)",
      "Bash(tsc *)",
      "Bash(type *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(git add *)",
      "Read(~/.claude)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Write(~/.claude/agents/**)",
      "Read(~/.claude/commands/**)",
      "Read(~/.claude/hooks/**)",
      "Write(~/.claude/skills/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)"
    ],
    "deny": [
      "Bash(/usr/bin/sudo *)",
      "Bash(1password *)",
      "Bash(1Password *)",
      "Bash(1pw *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl exec *)",
      "Bash(nc -l *)",
      "Bash(ncat -l *)",
      "Bash(netcat -l *)",
      "Bash(reboot *)",
      "Bash(rm -f -r .. *)",
      "Bash(rm -f -r ~)",
      "Bash(rm -f -r ~*)",
      "Bash(rm -f -r $HOME*)",
      "Bash(rm -fr .. *)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr ~*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -r -f .. *)",
      "Bash(rm -r -f ~)",
      "Bash(rm -r -f ~*)",
      "Bash(rm -r -f $HOME*)",
      "Bash(rm -rf .. *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(shutdown *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Read(.vscode/**)",
      "Read(**/.secrets/**)",
      "Read(**/*.keychain)",
      "Read(**/1password/**)",
      "Read(**/1Password/**)",
      "Read(**/passwords/**)",
      "Read(**/Passwords/**)",
      "Read(**/secrets/**)",
      "Read(**/wallet/**)",
      "Read(**/Wallet/**)",
      "Read(//Library/Keychains/**)",
      "Read(//Library/OpenDirectory/**)",
      "Read(//Library/Security/**)",
      "Read(//var/db/**)",
      "Read(~/.ssh/**)",
      "Read(~/Library/Application Support/1Password/**)",
      "Read(~/Library/Keychains/**)",
      "Read(*.env)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(gh pr create:*)",
      "Bash(git commit:*)",
      "Bash(rm:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jason/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": false,
    "mcp-server-dev@claude-plugins-official": false,
    "claude-api@anthropic-agent-skills": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "low",
  "tui": "fullscreen",
  "theme": "custom:my-theme",
  "editorMode": "vim",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(make deploy:*) in ~/Documents/litecard/lite-card-frontend",
      "Bash(make deploy-blue:*) in ~/Documents/litecard/lite-card-frontend",
      "Bash(make deploy-green:*) in ~/Documents/litecard/lite-card-frontend"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: AWS (seen in shell history: `aws` command used; no specific project/account confirmed)",
      "**Repository visibility**: Private — `LiteCard/lite-card-frontend` (confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch `main`; no protected branches listed and rulesets not queryable here — treat `main` as protected pending confirmation",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (`LiteCard/lite-card-frontend` on github.com) and its remote(s) only",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar; note `.env` is gitignored in this repo, treat as a credential location",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment; note Makefile has `deploy`, `deploy-blue`, `deploy-green` targets — treat any prod-tagged deploy target as sensitive",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: `/Users/jason/Documents/litecard/lite-card-frontend` (github.com/LiteCard/lite-card-frontend, private) and its configured remote",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
